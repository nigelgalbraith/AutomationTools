{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "router_specs",
    "config_fields"
  ],
  "properties": {
    "router_specs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "firmware",
        "hardware",
        "codec",
        "encode",
        "edit"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^(?=[\\s\\S]*\\S)[^\\r\\n\\u0000]+(?![\\s\\S])",
          "description": "Router model identifier. Required even for an otherwise unconfigured template."
        },
        "firmware": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?=[\\s\\S]*\\S)[^\\r\\n\\u0000]+(?![\\s\\S])",
          "description": "Known firmware version; null when unknown or not required."
        },
        "hardware": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?=[\\s\\S]*\\S)[^\\r\\n\\u0000]+(?![\\s\\S])",
          "description": "Known hardware or board identifier; null when unknown or not required."
        },
        "codec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "enum": [
                "base64",
                null
              ],
              "description": "Transport encoding method; null for binary data with no transport encoding."
            },
            "encryption": {
              "enum": [
                "aes-256-cbc",
                null
              ],
              "description": "Backup encryption algorithm, or null when no encryption applies."
            },
            "key_derivation": {
              "enum": [
                "openssl-legacy",
                "fixed-key",
                "device-key",
                null
              ],
              "description": "How backup encryption keys are obtained; required for encrypted backups."
            },
            "password_base": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[^\\r\\n\\u0000]*(?![\\s\\S])",
              "description": "Prefix applied to the password or its hash for legacy key derivation. Empty string is meaningful."
            },
            "password_hash": {
              "enum": [
                "none",
                "md5",
                "sha256",
                "sha512",
                null
              ],
              "description": "Hash applied to the password before key derivation; \"none\" uses its original text."
            },
            "key_derivation_digest": {
              "enum": [
                "md5",
                "sha256",
                "sha512",
                null
              ],
              "description": "OpenSSL legacy password-to-key digest."
            },
            "salted": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether legacy OpenSSL encryption uses a salt. False is a meaningful setting."
            },
            "password_required": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether legacy encryption requires an external factory password. False is meaningful."
            },
            "encryption_settings": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "key_hex",
                "iv_hex"
              ],
              "properties": {
                "key_hex": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-fA-F]{64}(?![\\s\\S])",
                  "description": "Encryption key as hexadecimal text; width is validated for the containing algorithm."
                },
                "iv_hex": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-fA-F]{32}(?![\\s\\S])",
                  "description": "Encryption IV as hexadecimal text."
                }
              },
              "description": "Fixed backup key and IV, or null for other key-derivation methods."
            },
            "wrapper": {
              "enum": [
                "line-wrapper",
                "encrypted-configuration",
                "technicolor-thenc",
                null
              ],
              "description": "Backup wrapper format, or null when no wrapper applies."
            },
            "archive": {
              "enum": [
                "tar.gz",
                "signed-zlib",
                null
              ],
              "description": "Decoded archive/compression format, or null when no archive processing applies."
            },
            "header_lines": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Number of wrapper header lines; zero is meaningful."
            },
            "preserve_header": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether a declared wrapper header is preserved when rebuilding the backup."
            },
            "payload_line_length": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "multipleOf": 4,
              "description": "Base64 output line width, in characters; required for Base64 encoding."
            },
            "newline": {
              "description": "Wrapper line separator; supported line wrappers use LF.",
              "enum": [
                "\n",
                null
              ]
            },
            "checksum": {
              "enum": [
                "md5",
                "sha256",
                "sha512",
                null
              ],
              "description": "Checksum algorithm for encoded payload bytes including newlines."
            },
            "checksum_after_payload_lines": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Number of encoded payload lines before the checksum line; zero is meaningful."
            },
            "checksum_prefix_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Random byte count before Base64 encoding the checksum-line prefix; zero is meaningful."
            },
            "trailer_character": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[\\u0000-\\u0009\\u000b\\u000c\\u000e-\\u007f](?![\\s\\S])",
              "description": "Single ASCII character repeated to form the wrapper trailer."
            },
            "trailer_repeat": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Number of trailer-character repetitions."
            },
            "iv_length": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Binary IV length in the wrapper, in bytes."
            },
            "signature_length": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Trailing binary signature length, in bytes."
            },
            "preamble": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "^[\\r\\n -~]+(?![\\s\\S])",
              "description": "Expected wrapper preamble or XML declaration prefix."
            },
            "backup_version": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "^(?=[ -~]*[^ ])[ -~]+(?![\\s\\S])",
              "description": "Expected binary wrapper version."
            },
            "header_terminator": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "^[\\r\\n -~]+(?![\\s\\S])",
              "description": "ASCII delimiter separating the wrapper header from binary payload bytes."
            },
            "signature": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "algorithm",
                "modulus_hex",
                "exponent"
              ],
              "properties": {
                "algorithm": {
                  "description": "Selected signature or protected-field encryption algorithm.",
                  "enum": [
                    "rsa-md5",
                    null
                  ]
                },
                "modulus_hex": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 128,
                  "maxLength": 2048,
                  "pattern": "^0*(?:[89a-fA-F][0-9a-fA-F]{127}|[1-9a-fA-F][0-9a-fA-F]{128,})(?![\\s\\S])",
                  "allOf": [
                    {
                      "pattern": "[13579bBdDfF](?![\\s\\S])"
                    }
                  ],
                  "description": "RSA public modulus as hexadecimal text."
                },
                "exponent": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 3,
                  "maximum": 4294967295,
                  "not": {
                    "type": "integer",
                    "multipleOf": 2
                  },
                  "description": "RSA public exponent."
                }
              },
              "description": "Public signature-verification parameters, or null for backups without supported signing."
            },
            "decode_order": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "wrapper",
                  "encoding",
                  "encryption",
                  "archive"
                ]
              },
              "description": "Explicit decode operation order, or null to use the existing wrapper/encoding/encryption/archive order."
            },
            "encode_order": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "wrapper",
                  "encoding",
                  "encryption",
                  "archive"
                ]
              },
              "description": "Explicit encode operation order, or null to use the existing archive/encryption/encoding/wrapper order."
            }
          },
          "description": "Shared decode and encode settings. Every supported key is present; unused settings are null.",
          "required": [
            "encoding",
            "encryption",
            "key_derivation",
            "password_base",
            "password_hash",
            "key_derivation_digest",
            "salted",
            "password_required",
            "encryption_settings",
            "wrapper",
            "archive",
            "header_lines",
            "preserve_header",
            "payload_line_length",
            "newline",
            "checksum",
            "checksum_after_payload_lines",
            "checksum_prefix_bytes",
            "trailer_character",
            "trailer_repeat",
            "iv_length",
            "signature_length",
            "preamble",
            "backup_version",
            "header_terminator",
            "signature",
            "decode_order",
            "encode_order"
          ]
        },
        "encode": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "private_exponent_hex": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(?!0*[01](?![\\s\\S]))[0-9a-fA-F]+(?![\\s\\S])",
              "minLength": 1,
              "description": "RSA private signing exponent as hexadecimal text; null permits decode-only use."
            }
          },
          "description": "Additional encoding settings, or null when no encoding-specific settings apply.",
          "required": [
            "private_exponent_hex"
          ]
        },
        "edit": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "configuration_file",
            "configuration_format",
            "field_encryption"
          ],
          "properties": {
            "configuration_file": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))(?=[\\s\\S]*\\S)[^\\r\\n\\u0000]+(?![\\s\\S])",
              "description": "Safe relative path of the configuration file inside decoded contents."
            },
            "configuration_format": {
              "enum": [
                "key-value",
                "xml",
                null
              ],
              "description": "Parser/editor used for the configuration file."
            },
            "field_encryption": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "algorithm",
                "key_hex",
                "iv_hex",
                "fields"
              ],
              "properties": {
                "algorithm": {
                  "description": "Selected signature or protected-field encryption algorithm.",
                  "enum": [
                    "aes-128-cbc-zero-padded-base64",
                    null
                  ]
                },
                "key_hex": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-fA-F]{32}(?![\\s\\S])",
                  "description": "Encryption key as hexadecimal text; width is validated for the containing algorithm."
                },
                "iv_hex": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-fA-F]{32}(?![\\s\\S])",
                  "description": "Encryption IV as hexadecimal text."
                },
                "fields": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Logical names of configuration fields protected by the selected field encryption algorithm."
                }
              },
              "description": "Encryption settings for selected configuration fields, or null when fields are not encrypted."
            }
          },
          "description": "Configuration editing settings, or null when the configuration format is not established."
        }
      },
      "description": "Router identity and the complete common codec, encoding and editing settings."
    },
    "config_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Unique logical configuration field name."
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "Actual key or XML selector; null denotes an unknown or unavailable mapping."
          }
        }
      },
      "description": "Logical configuration field mappings; entry counts and paths may differ by model."
    }
  },
  "description": "Common router specification structure. All setting keys are required; null marks unused settings. Selected algorithms still require their parameters in Python validation."
}
