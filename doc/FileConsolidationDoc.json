{
  "FIXED_FIELDS": [
    "<GROUP>.file_keys",
    "<GROUP>.file_keys.source_directory",
    "<GROUP>.file_keys.destination_directory",
    "<GROUP>.file_keys.archive_extensions",
    "<GROUP>.organization_keys",
    "<GROUP>.year_keys",
    "<GROUP>.year_keys.directories",
    "<GROUP>.month_keys",
    "<GROUP>.month_keys.directories",
    "<GROUP>.month_keys.year_patterns"
  ],
  "EDITABLE_FIELDS": [
    "<GROUP>",
    "<GROUP>.file_keys.source_directory",
    "<GROUP>.file_keys.destination_directory",
    "<GROUP>.file_keys.archive_extensions.<VALUES>",
    "<GROUP>.organization_keys.<CATEGORY>",
    "<GROUP>.organization_keys.<CATEGORY>.directory",
    "<GROUP>.organization_keys.<CATEGORY>.extensions.<VALUES>",
    "<GROUP>.year_keys.directories.<VALUES>",
    "<GROUP>.month_keys.directories.<VALUES>",
    "<GROUP>.month_keys.year_patterns.<VALUES>"
  ],
  "EXAMPLE": {
    "Files": {
      "file_keys": {
        "source_directory": "~/Downloads/Source",
        "destination_directory": "~/Downloads/Consolidated",
        "archive_extensions": [
          ".zip",
          ".tar",
          ".tar.gz",
          ".tgz",
          ".tar.bz2",
          ".tar.xz"
        ]
      },
      "organization_keys": {
        "documents": {
          "directory": "~/Downloads/Consolidated/Documents",
          "extensions": [".pdf", ".doc", ".docx", ".odt", ".txt", ".rtf"]
        },
        "spreadsheets": {
          "directory": "~/Downloads/Consolidated/Spreadsheets",
          "extensions": [".xls", ".xlsx", ".ods", ".csv", ".xlsm"]
        },
        "images": {
          "directory": "~/Downloads/Consolidated/Images",
          "extensions": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tif", ".tiff", ".webp", ".svg", ".heic"]
        },
        "video": {
          "directory": "~/Downloads/Consolidated/Video",
          "extensions": [".mp4", ".mkv", ".avi", ".mov", ".wmv", ".mpeg", ".mpg", ".webm"]
        },
        "music": {
          "directory": "~/Downloads/Consolidated/Music",
          "extensions": [".mp3", ".wav", ".flac", ".ogg", ".aac", ".m4a", ".wma"]
        },
        "html": {
          "directory": "~/Downloads/Consolidated/HTML",
          "extensions": [".html", ".htm"]
        },
        "unknown": {
          "directory": "~/Downloads/Consolidated/Unknown",
          "extensions": []
        }
      },
      "year_keys": {
        "directories": [
          "~/Downloads/Consolidated/Documents",
          "~/Downloads/Consolidated/Spreadsheets",
          "~/Downloads/Consolidated/Images",
          "~/Downloads/Consolidated/Video"
        ]
      },
      "month_keys": {
        "directories": [
          "~/Downloads/Consolidated/Images",
          "~/Downloads/Consolidated/Video"
        ],
        "year_patterns": [
          "19[0-9][0-9]",
          "20[0-9][0-9]"
        ]
      }
    }
  },
  "DESCRIPTION": {
    "<GROUP>": "Each top-level JSON key is a named file consolidation job.",
    "<GROUP>.file_keys": "Required. Configuration for archive extraction and file consolidation.",
    "<GROUP>.file_keys.source_directory": "Required. Existing source directory containing files, folders and archives.",
    "<GROUP>.file_keys.destination_directory": "Required. Destination directory where files are consolidated.",
    "<GROUP>.file_keys.archive_extensions": "Required. List of archive extensions. An empty list disables archive extraction.",
    "<GROUP>.organization_keys": "Required. Dictionary of file organization categories. An empty dictionary disables file type organization.",
    "<GROUP>.organization_keys.<CATEGORY>": "Optional. Named file organization category.",
    "<GROUP>.organization_keys.<CATEGORY>.directory": "Destination directory for the category.",
    "<GROUP>.organization_keys.<CATEGORY>.extensions": "List of matching file extensions. An empty list collects all remaining files. Catch-all categories should be placed last.",
    "<GROUP>.year_keys": "Required. Configuration for year organization.",
    "<GROUP>.year_keys.directories": "Required. List of directories to organize by modification year. An empty list disables year organization.",
    "<GROUP>.month_keys": "Required. Configuration for month organization.",
    "<GROUP>.month_keys.directories": "Required. List of directories containing year subdirectories. An empty list disables month organization.",
    "<GROUP>.month_keys.year_patterns": "Required. Glob patterns identifying year directories. An empty list matches no year directories."
  }
}